rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profiles
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
      allow delete: if isAdmin();
    }

    // Projects collection
    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.name is string;
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Pipelines collection
    match /pipelines/{pipelineId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Deployments
    match /deployments/{deploymentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Security scans & Vulnerabilities
    match /securityScans/{scanId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /vulnerabilities/{vulnId} {
      allow read: if isSignedIn();
      allow update: if isSignedIn();
      allow write: if isAdmin();
    }

    // Incidents & Self-Healing Actions
    match /incidents/{incidentId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /healingActions/{actionId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Monitoring metrics
    match /monitoringMetrics/{metricId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow update: if isSignedIn();
      allow create, delete: if isAdmin();
    }

    // Audit logs (Immutable)
    match /auditLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false; // Immutable audit trail
    }

    // AI Analyses
    match /aiAnalyses/{analysisId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}
