# Runtime: DEMO_MODE=true is safe and never calls infrastructure. Set false only after
# authentication and the live integrations below are configured.
PORT=3000
DEMO_MODE=true
DATA_DIR=.data
WORKSPACE_ROOT=.workspaces
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Live authentication (required when DEMO_MODE=false).
# Comma-separated opaque-token:email:ROLE entries. Store this secret in your deployment's
# secret manager, not in this file. Roles: ADMIN, DEVOPS_ENGINEER, SECURITY_ENGINEER, DEVELOPER, VIEWER.
API_TOKENS=replace-with-a-long-random-token:admin@example.com:ADMIN

# AI (optional; deterministic fallback remains available if omitted)
GEMINI_API_KEY=

# Monitoring
PROMETHEUS_URL=http://prometheus:9090

# Kubernetes / container registry. kubectl must be installed and authenticated in the backend runtime.
KUBECTL_BIN=kubectl
KUBERNETES_NAMESPACE=healops
CONTAINER_REGISTRY=registry.example.com/healops

# Live pipeline prerequisites installed in the backend runtime:
# git, npm, semgrep, trivy, gitleaks, docker, kubectl
